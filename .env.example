# MODELO das variáveis de ambiente. Este arquivo VAI para o Git (sem senhas reais).
#
# Como usar:
#   1. Copie este arquivo para ".env" (o .env NÃO vai para o Git).
#   2. Troque as senhas por senhas fortes.
#
# Quem lê o .env:
#   - o docker compose, automaticamente;
#   - o Spring Boot, pela linha spring.config.import do application.properties.

# ── Banco de dados ──
DB_NAME=pastelaria
DB_USERNAME=pastelaria
DB_PASSWORD=troque-por-uma-senha-forte
# Em casa, NÃO defina DB_URL (vale localhost:5435). Só no servidor:
# DB_URL=jdbc:postgresql://endereco-do-banco:porta/nome-do-banco

# ── Administrador inicial ──
# Usado só no primeiro start, para criar o admin se ele não existir.
# Depois de criado, mudar aqui NÃO muda a senha dele.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-por-uma-senha-com-12-ou-mais-caracteres
